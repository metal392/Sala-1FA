        "#escrever um programa que recebe as notas do 04 bimestre e imprime a média com o  resultado aprovado, recuperação ou reprovado\n",
        "\n",
        "#contições: utilizar while\n",
        "# nota igual ou maior que  7 = aprovado\n",
        "#nota igual ou maior que 5 = recuperação\n",
        "#nota menor que 5 = reprovado\n",
        "\n",
        "bimestre = 1\n",
        "total_notas = 0\n",
        "\n",
        "while bimestre <= 4:\n",
        "  try:\n",
        "    nota = float(input(f\"Digite a nota do {bimestre}º bimestre: \"))\n",
        "    if 0 <= nota <= 10:\n",
        "      total_notas += nota\n",
        "      bimestre += 1\n",
        "    else:\n",
        "      print(\"A nota deve estar entre 0 e 10.\")\n",
        "  except ValueError:\n",
        "    print(\"Entrada inválida. Por favor, digite um número.\")\n",
        "\n",
        "if bimestre > 1:\n",
        "  media = total_notas / (bimestre -1)\n",
        "  print(f\"\\nMédia final: {media:.2f}\")\n",
        "\n",
        "  if media >= 7:\n",
        "    print(\"Resultado: Aprovado\")\n",
        "  elif media >= 5:\n",
        "    print(\"Resultado: Recuperação\")\n",
        "  else:\n",
        "    print(\"Resultado: Reprovado\")\n",
        "else:\n",
        "  print(\"Nenhuma nota foi inserida para calcular a média.\")\n",
